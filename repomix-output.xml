<file path="Utilidades.html">
<script>
  /**
   * Utilidades.html
   * Funciones auxiliares compartidas por los módulos de UI/Service del
   * frontend. Ninguna de estas funciones llama a google.script.run: eso es
   * responsabilidad exclusiva de los archivos "*API.html".
   */
  const Utilidades = {
    formatoMoneda: new Intl.NumberFormat('es-CO', { style: 'currency', currency: 'COP', minimumFractionDigits: 0 }),

    formatearMoneda(valor) {
      return this.formatoMoneda.format(Number(valor) || 0);
    },

    obtenerCampo(objeto, ...nombres) {
      for (const nombre of nombres) {
        const valor = objeto[nombre];
        if (valor !== undefined && valor !== null && valor !== '') return valor;
      }
      return undefined;
    },

    /**
     * Fecha de hoy en formato ISO "AAAA-MM-DD" usando componentes LOCALES
     * (no toISOString(), que convierte a UTC y puede mostrar el día
     * equivocado en horas de la noche en Colombia).
     */
    fechaLocalISO(fecha) {
      const d = fecha || new Date();
      const y = d.getFullYear();
      const m = String(d.getMonth() + 1).padStart(2, '0');
      const dia = String(d.getDate()).padStart(2, '0');
      return `${y}-${m}-${dia}`;
    },

    /**
     * Convierte a ENTERO positivo (o null) lo que venga de un <select>/<input>.
     * El `value` de un elemento HTML SIEMPRE es texto ("3"): los IDs del sistema
     * son números, así que hay que convertirlos antes de comparar o enviar
     * ("3" === 3 es false).
     */
    aId(valor) {
      if (typeof valor === 'number') return (Number.isSafeInteger(valor) && valor > 0) ? valor : null;
      if (typeof valor === 'string' && /^\s*\d+\s*$/.test(valor)) {
        const n = Number(valor);
        return (Number.isSafeInteger(n) && n > 0) ? n : null;
      }
      return null;
    },

    /**
     * Determina si una categoría es de tipo Ingreso, buscándola por ID (mismo
     * criterio que usa el backend: Categorias.Tipo), para que la clasificación
     * visual de un movimiento sea siempre consistente con los cálculos.
     */
    esCategoriaIngreso(categorias, idCategoria) {
      const id = this.aId(idCategoria);
      const info = categorias.find(c => c.idCategoria === id);
      return !!info && info.tipo === 'Ingreso';
    },

    mostrarError(mensaje) {
      console.error(mensaje);
      const contenedor = document.getElementById('banner-error');
      if (!contenedor) { alert(mensaje); return; }
      contenedor.textContent = mensaje;
      contenedor.classList.remove('d-none');
      clearTimeout(this._timeoutError);
      this._timeoutError = setTimeout(() => contenedor.classList.add('d-none'), 5000);
    }
  };
</script>
