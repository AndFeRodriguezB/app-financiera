<file path="CuentasAPI.html">
<script>
  /**
   * CuentasAPI.html
   * Capa "API" del frontend para la administración de cuentas: el único lugar
   * que sabe que existe google.script.run para estas operaciones. Todas las
   * respuestas del servidor tienen la forma { cuentas, cuenta }: la lista
   * completa y actualizada de las cuentas del usuario y la cuenta afectada.
   * El cliente NUNCA envía el ID del propietario: lo decide el servidor.
   */
  const CuentasAPI = {
    obtener(onSuccess, onError) {
      google.script.run.withSuccessHandler(onSuccess).withFailureHandler(onError).obtenerCuentasDelUsuarioActual();
    },
    crear(datos, onSuccess, onError) {
      google.script.run.withSuccessHandler(onSuccess).withFailureHandler(onError).crearCuenta(datos);
    },
    actualizar(idCuenta, datos, onSuccess, onError) {
      google.script.run.withSuccessHandler(onSuccess).withFailureHandler(onError).actualizarCuenta(idCuenta, datos);
    },
    cambiarEstado(idCuenta, activa, onSuccess, onError) {
      google.script.run.withSuccessHandler(onSuccess).withFailureHandler(onError).cambiarEstadoCuenta(idCuenta, activa);
    }
  };
</script>
</file>

<file path="CuentasService.html">
<script>
  /**
   * CuentasService.html
   * Lógica de negocio de Configuración > Mis cuentas: carga la lista, abre el
   * formulario de creación/edición, valida por comodidad (el servidor vuelve a
   * validar TODO), y mantiene Store.catalogos.cuentas sincronizado para que los
   * selectores de Movimientos reflejen de inmediato las cuentas nuevas,
   * renombradas, desactivadas o reactivadas.
   *
   * Las cuentas no se eliminan: se desactivan. Una cuenta inactiva deja de
   * ofrecerse en movimientos NUEVOS, pero el historial sigue mostrándola.
   */
  const CuentasService = {
    // Se llama una sola vez al arrancar (App.html): los elementos de Configuración ya existen en el DOM.
    configurar() {
      CuentasUI.llenarTipos();
      document.getElementById('btn-nueva-cuenta').addEventListener('click', () => this.nuevaCuenta());
      document.getElementById('btn-guardar-cuenta').addEventListener('click', () => this.guardar());
      document.getElementById('cuenta-tipo').addEventListener('change', e => CuentasUI.mostrarCamposCredito(e.target.value === 'Credito'));
    },

    // Primera visita a Configuración: carga la lista (con la cantidad de movimientos de cada cuenta).
    alMostrarConfiguracion() {
      if (!Store.meta.cuentasCargadas) this.recargar();
    },

    recargar() {
      CuentasUI.mostrarCargando();
      CuentasAPI.obtener(
        (respuesta) => this.procesarRespuesta(respuesta),
        (error) => {
          CuentasUI.mostrarErrorDeCarga();
          Utilidades.mostrarError('No se pudieron cargar tus cuentas: ' + error.message);
        }
      );
    },

    procesarRespuesta(respuesta) {
      const propias = (respuesta && respuesta.cuentas) || [];
      Store.cuentasUsuario = propias;
      this._sincronizarCatalogo(propias);
      Store.meta.cuentasCargadas = true;
      CuentasUI.renderizarLista(propias);
    },

    // Reemplaza en el catálogo global SOLO las cuentas del usuario actual (las de los demás no cambian).
    _sincronizarCatalogo(propias) {
      const idActual = Store.idUsuarioActual;
      const ajenas = Store.catalogos.cuentas.filter(c => c.idUsuario !== idActual);
      Store.catalogos.cuentas = ajenas.concat(propias);
    },

    nuevaCuenta() {
      CuentasUI.abrirFormulario(null);
    },

    editarCuenta(idCuenta) {
      const cuenta = Store.cuentasUsuario.find(c => c.idCuenta === idCuenta);
      if (cuenta) CuentasUI.abrirFormulario(cuenta);
    },

    /** Lee el formulario. El ID y el propietario NO forman parte de lo que se envía. */
    leerFormulario() {
      const tipo = document.getElementById('cuenta-tipo').value;
      const numeroODefecto = (id) => {
        const texto = document.getElementById(id).value;
        return texto === '' ? null : Number(texto.replace(/\./g, ''));
      };
      return {
        nombre: document.getElementById('cuenta-nombre').value.trim(),
        tipo,
        cupoTotal: tipo === 'Credito' ? numeroODefecto('cuenta-cupo') : null,
        diaCorte: tipo === 'Credito' ? numeroODefecto('cuenta-dia-corte') : null,
        diaPago: tipo === 'Credito' ? numeroODefecto('cuenta-dia-pago') : null
      };
    },

    _errorDeFormulario(datos) {
      if (!datos.nombre) return 'Escribe un nombre para la cuenta.';
      if (!datos.tipo) return 'Selecciona el tipo de cuenta (Débito o Crédito).';
      if (datos.tipo === 'Credito') {
        if (!datos.cupoTotal || datos.cupoTotal <= 0) return 'Escribe el cupo total de la tarjeta de crédito.';
        const diaValido = d => Number.isInteger(d) && d >= 1 && d <= 31;
        if (!diaValido(datos.diaCorte)) return 'El día de corte debe estar entre 1 y 31.';
        if (!diaValido(datos.diaPago)) return 'El día de pago debe estar entre 1 y 31.';
      }
      return null;
    },

    guardar() {
      const idEdicion = document.getElementById('cuenta-id-edicion').value;
      const datos = this.leerFormulario();
      const error = this._errorDeFormulario(datos);
      if (error) { Utilidades.mostrarError(error); return; }

      MovimientosUI.bloquearBoton('btn-guardar-cuenta', true);
      const alTerminar = (respuesta) => {
        MovimientosUI.bloquearBoton('btn-guardar-cuenta', false);
        CuentasUI.cerrarFormulario();
        this.procesarRespuesta(respuesta);
      };
      const alFallar = (e) => {
        MovimientosUI.bloquearBoton('btn-guardar-cuenta', false);
        Utilidades.mostrarError('No se pudo guardar la cuenta: ' + e.message);
      };

      if (idEdicion) CuentasAPI.actualizar(Number(idEdicion), datos, alTerminar, alFallar);
      else CuentasAPI.crear(datos, alTerminar, alFallar);
    },

    cambiarEstado(idCuenta, activa) {
      const cuenta = Store.cuentasUsuario.find(c => c.idCuenta === idCuenta);
      if (!cuenta) return;
      if (!activa) {
        const detalle = cuenta.cantidadMovimientos > 0
          ? ` Sus ${cuenta.cantidadMovimientos} movimiento(s) se conservan tal cual.` : '';
        if (!confirm(`¿Desactivar "${cuenta.nombre}"? Dejará de aparecer al registrar movimientos nuevos.${detalle} Podrás reactivarla cuando quieras.`)) return;
      }
      CuentasAPI.cambiarEstado(
        idCuenta, activa,
        (respuesta) => this.procesarRespuesta(respuesta),
        (e) => Utilidades.mostrarError('No se pudo cambiar el estado de la cuenta: ' + e.message)
      );
    }
  };
</script>
</file>

<file path="CuentasUI.html">
<script>
  /**
   * CuentasUI.html
   * Única responsabilidad: manipular el DOM de Configuración > Mis cuentas y de
   * su formulario. No decide reglas de negocio ni llama a Apps Script. Los
   * nombres se insertan con textContent (nunca como HTML) y no se muestran IDs.
   */
  const CuentasUI = {
    TIPOS: [['Debito', 'Débito'], ['Credito', 'Crédito']],

    llenarTipos() {
      const select = document.getElementById('cuenta-tipo');
      select.innerHTML = '<option value="" selected disabled>Selecciona el tipo...</option>';
      this.TIPOS.forEach(([valor, texto]) => {
        const opcion = document.createElement('option');
        opcion.value = valor;
        opcion.textContent = texto;
        select.appendChild(opcion);
      });
    },

    // Cupo, día de corte y día de pago solo aplican a las cuentas de crédito.
    mostrarCamposCredito(mostrar) {
      document.getElementById('cuenta-div-credito').classList.toggle('d-none', !mostrar);
    },

    mostrarCargando() {
      document.getElementById('lista-cuentas').innerHTML = `
        <div class="text-center text-muted py-4">
          <div class="spinner-border spinner-border-sm text-primary me-2" role="status"></div>
          Cargando tus cuentas...
        </div>`;
    },

    mostrarErrorDeCarga() {
      document.getElementById('lista-cuentas').innerHTML =
        '<div class="text-center text-muted py-4">No se pudieron cargar tus cuentas. Vuelve a abrir esta sección para reintentar.</div>';
      Store.meta.cuentasCargadas = false;
    },

    renderizarLista(cuentas) {
      const contenedor = document.getElementById('lista-cuentas');
      contenedor.innerHTML = '';

      const hayActivas = cuentas.some(c => c.activa);
      document.getElementById('cuentas-aviso').classList.toggle('d-none', hayActivas);

      if (cuentas.length === 0) {
        contenedor.innerHTML = '<div class="text-center text-muted py-4">Aún no tienes cuentas. Crea una para poder registrar tus gastos e ingresos.</div>';
        return;
      }
      cuentas.forEach(c => contenedor.appendChild(this._crearTarjeta(c)));
    },

    _crearTarjeta(c) {
      const tarjeta = document.createElement('div');
      tarjeta.className = 'card shadow-sm' + (c.activa ? '' : ' opacity-75');

      const cuerpo = document.createElement('div');
      cuerpo.className = 'card-body d-flex justify-content-between align-items-start gap-2';

      const info = document.createElement('div');
      const titulo = document.createElement('div');
      titulo.className = 'fw-semibold';
      const nombre = document.createElement('span');
      nombre.textContent = c.nombre;
      const tipo = document.createElement('span');
      tipo.className = 'badge text-bg-light ms-2';
      tipo.textContent = c.tipo === 'Credito' ? 'Crédito' : 'Débito';
      titulo.appendChild(nombre);
      titulo.appendChild(tipo);
      info.appendChild(titulo);

      if (c.tipo === 'Credito') {
        const credito = document.createElement('div');
        credito.className = 'small text-muted';
        const dia = d => (d === null || d === undefined) ? '—' : 'día ' + d;
        credito.textContent = `Cupo: ${c.cupoTotal === null || c.cupoTotal === undefined ? '—' : Utilidades.formatearMoneda(c.cupoTotal)} · Corte: ${dia(c.diaCorte)} · Pago: ${dia(c.diaPago)}`;
        info.appendChild(credito);
      }

      const estado = document.createElement('div');
      estado.className = 'small ' + (c.activa ? 'text-success' : 'text-muted');
      const n = c.cantidadMovimientos || 0;
      estado.textContent = `${c.activa ? 'Activa' : 'Inactiva'} · ${n} movimiento${n === 1 ? '' : 's'}`;
      info.appendChild(estado);

      const acciones = document.createElement('div');
      acciones.className = 'd-flex gap-1 flex-shrink-0';

      const editar = document.createElement('button');
      editar.type = 'button';
      editar.className = 'btn btn-sm btn-outline-secondary';
      editar.title = 'Editar';
      editar.textContent = 'Editar';
      editar.addEventListener('click', () => CuentasService.editarCuenta(c.idCuenta));

      const alternar = document.createElement('button');
      alternar.type = 'button';
      alternar.className = 'btn btn-sm ' + (c.activa ? 'btn-outline-danger' : 'btn-outline-success');
      alternar.textContent = c.activa ? 'Desactivar' : 'Reactivar';
      alternar.addEventListener('click', () => CuentasService.cambiarEstado(c.idCuenta, !c.activa));

      acciones.appendChild(editar);
      acciones.appendChild(alternar);
      cuerpo.appendChild(info);
      cuerpo.appendChild(acciones);
      tarjeta.appendChild(cuerpo);
      return tarjeta;
    },

    abrirFormulario(cuenta) {
      document.getElementById('formulario-cuenta').reset();
      document.getElementById('cuenta-id-edicion').value = cuenta ? cuenta.idCuenta : '';
      document.getElementById('modalCuentaLabel').textContent = cuenta ? 'Editar cuenta' : 'Nueva cuenta';
      document.getElementById('btn-guardar-cuenta').textContent = cuenta ? 'Guardar cambios' : 'Guardar';

      if (cuenta) {
        document.getElementById('cuenta-nombre').value = cuenta.nombre;
        document.getElementById('cuenta-tipo').value = cuenta.tipo;
        const esCredito = cuenta.tipo === 'Credito';
        document.getElementById('cuenta-cupo').value = esCredito && cuenta.cupoTotal ? new Intl.NumberFormat('es-CO').format(cuenta.cupoTotal) : '';
        document.getElementById('cuenta-dia-corte').value = esCredito && cuenta.diaCorte ? cuenta.diaCorte : '';
        document.getElementById('cuenta-dia-pago').value = esCredito && cuenta.diaPago ? cuenta.diaPago : '';
        this.mostrarCamposCredito(esCredito);
      } else {
        this.mostrarCamposCredito(false);
      }
      new bootstrap.Modal(document.getElementById('modalCuenta')).show();
    },

    cerrarFormulario() {
      const instancia = bootstrap.Modal.getInstance(document.getElementById('modalCuenta'));
      if (instancia) instancia.hide();
    }
  };
</script>
